# Telegram — получить у @BotFather
TELEGRAM_BOT_TOKEN=

# Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Модели Claude — см. актуальный список на https://docs.claude.com/en/docs/about-claude/models
CLAUDE_MODEL_MAIN=claude-sonnet-4-5
CLAUDE_MODEL_SUMMARY=claude-haiku-4-5

# Список Telegram user ID, которым разрешено управлять ботом, через запятую.
# Узнать свой ID: написать @userinfobot в Telegram
ALLOWED_TELEGRAM_IDS=

# SQLite по умолчанию (WAL mode) — подходит для одного VPS с ограниченной RAM
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

CODE_WORKSPACE=/opt/ai-workspace
ALLOWED_PATHS=/opt,/var/www,/home/bot/workspace
BACKUP_DIR=/var/backups/ai-assistant

VOICE_RESPONSES_ENABLED=false
VOICE_RESPONSE_MODE=auto

# Память диалога: при превышении бюджета токенов старая история суммаризируется
CONTEXT_TOKEN_BUDGET=24000
HISTORY_KEEP_RECENT=10
HISTORY_MAX_MESSAGES=30
SUMMARY_MAX_TOKENS=600

# Мониторинг: как часто проверять правила и минимальный интервал между повторными алертами
MONITOR_CHECK_INTERVAL_SECONDS=30
MONITOR_ALERT_COOLDOWN_MINUTES=30

MAX_COMMAND_TIMEOUT=30
MAX_OUTPUT_SIZE=20000
MAX_FILE_SIZE=20MB
MAX_CODE_FIX_ITERATIONS=5

LOG_LEVEL=INFO
TIMEZONE=UTC
